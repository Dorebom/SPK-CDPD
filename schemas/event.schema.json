{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdpd:event:1",
  "title": "cdpd.event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer_id",
    "producer_instance_id",
    "operation_id",
    "kind"
  ],
  "properties": {
    "schema": {
      "const": "cdpd.event/v1"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "producer_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "ACTION_STARTED",
        "ACTION_FINISHED",
        "ACTION_FAILED",
        "OBSERVATION_FAILED",
        "HEARTBEAT",
        "MANUAL"
      ]
    },
    "failure_code": {
      "enum": [
        "NONE",
        "TARGET_MISSING",
        "TARGET_AMBIGUOUS",
        "NOT_INTERACTABLE",
        "TIMEOUT",
        "UNKNOWN",
        "DISCONNECTED",
        "RECONCILE_REQUIRED",
        "POSTCONDITION_FAILED"
      ]
    },
    "correlation": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      }
    }
  }
}
